#include <winuser.h>
#include <winver.h>

1 RT_MANIFEST "app.manifest"

// The application's own icon (Explorer file icon, taskbar, Alt-Tab).
// Resource ID 1 is also what QIcon(":/...")-free Qt apps commonly assume
// for the "default" icon, but this app sets its window/tray icon
// explicitly in code (MainWindow.cpp) via Assets/application/motiva.ico
// rather than relying on resource-ID lookup, so this entry only governs
// the .exe file's own icon as seen in Explorer/taskbar - see CLAUDE.md's
// "Assets folder" entry.
1 ICON "../Assets/application/motiva.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Motiva"
            VALUE "FileDescription", "Motiva - live desktop wallpaper"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Motiva"
            VALUE "OriginalFilename", "Motiva.exe"
            VALUE "ProductName", "Motiva"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
