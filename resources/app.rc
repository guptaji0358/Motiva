#include <winuser.h>
#include <winver.h>

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Motiva"
            VALUE "FileDescription", "Motiva - live desktop wallpaper"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Motiva"
            VALUE "OriginalFilename", "Motiva.exe"
            VALUE "ProductName", "Motiva"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
